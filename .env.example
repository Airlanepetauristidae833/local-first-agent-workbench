COMPOSE_PROJECT_NAME=local-first-agent
APP_NAME=Local-First Agent API
APP_VERSION=1.0.0
API_LOG_LEVEL=INFO
TZ=UTC

# All published ports remain loopback-only. Add a private reverse proxy or VPN
# outside this Compose project when remote access is required.
API_BIND=127.0.0.1
API_PORT=8000
OPEN_WEBUI_BIND=127.0.0.1
OPEN_WEBUI_PORT=3000
OPEN_WEBUI_URL=http://127.0.0.1:3000
AGENT_WORKBENCH_URL=http://127.0.0.1:8000/console
OPEN_WEBUI_CORS_ALLOW_ORIGIN=http://127.0.0.1:3000;http://localhost:3000
OPEN_WEBUI_ENABLE_SIGNUP=true
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.0
OPEN_WEBUI_UPSTREAM_TIMEOUT_SECONDS=3600

# Bootstrap renders secrets, databases, logs, and generated configuration below
# this ignored directory. CI can point it at an external temporary directory.
LOCAL_STATE_ROOT=./runtime
WORKSPACE_HOST_ROOT=./workspaces
OBSIDIAN_VAULT_HOST_ROOT=./vault
KNOWLEDGE_SOURCE_HOST_ROOT=./knowledge-sources

# Install Ollama on the host and choose a model that exists locally.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.6:27b
OLLAMA_CONNECT_TIMEOUT_SECONDS=3
OLLAMA_REQUEST_TIMEOUT_SECONDS=1200
OLLAMA_FIRST_TOKEN_TIMEOUT_SECONDS=180
OLLAMA_STREAM_IDLE_TIMEOUT_SECONDS=90
OLLAMA_KEEP_ALIVE=30m
OLLAMA_THINK=false
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_NUM_PREDICT=4096

# Durable Agent context policy. Raw messages remain stored; older history is
# summarized when the compact trigger is reached.
AGENT_CONTEXT_BUDGET_TOKENS=10000
AGENT_CONTEXT_COMPACT_TRIGGER_TOKENS=7000
AGENT_CONTEXT_RECENT_MESSAGES=8
AGENT_CONTEXT_SUMMARY_MAX_TOKENS=1200

# Open WebUI uses the same local model for rolling context compaction.
OPENWEBUI_CONTEXT_COMPACTION_MODEL=qwen3.6:27b
OPENWEBUI_CONTEXT_COMPACTION_TOKEN_THRESHOLD=10000
OPENWEBUI_CONTEXT_COMPACTION_RETENTION_PERCENTAGE=40

# Knowledge indexing and watcher watchdogs.
KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-m3
KNOWLEDGE_MAX_TEXT_CHARS_PER_FILE=500000
KNOWLEDGE_SWEEP_SECONDS=300
KNOWLEDGE_WATCH_REFRESH_SECONDS=15
KNOWLEDGE_WATCH_POLL_MS=5000
KNOWLEDGE_ORPHAN_GRACE_SECONDS=300

# Startup waits for all four containers before registering the Agent provider.
STARTUP_TIMEOUT_SECONDS=360
SEARXNG_IMAGE=searxng/searxng:2026.7.26-b060c780d
